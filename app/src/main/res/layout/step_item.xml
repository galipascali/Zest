<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/stepPosition"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginHorizontal="15dp"
        android:gravity="center"
        android:text="1"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/app_green"
        android:backgroundTintMode="src_over"
        android:background="@drawable/circle_outline"/>

     <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/instructionTextField"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="@string/instruction_text_placeholder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="20"
        android:textColorHint="@color/medium_grey"
        app:boxBackgroundColor="@color/white"
        app:shapeAppearanceOverlay="@style/roundedTextBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"/>
    </com.google.android.material.textfield.TextInputLayout>

    <ImageView
        android:id="@+id/deleteStep"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:src="@drawable/delete"/>
</LinearLayout>